name: Deploy GitHub Pages
on:
  push: { branches: [main] }
  workflow_dispatch:
permissions: { contents: read, pages: write, id-token: write }
concurrency: { group: pages, cancel-in-progress: true }
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with: { node-version: 20, cache: npm }
      - run: npm ci
      - run: npm run build
      - uses: actions/configure-pages@v5
      - uses: actions/upload-pages-artifact@v3
        with: { path: dist }
  deploy:
    needs: build
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - id: deployment
        uses: actions/deploy-pages@v4

# ---------------------------------------------------------------------------
# COMO ATIVAR O DEPLOY AUTOMÁTICO NO GITHUB PAGES
#
#   mkdir -p .github/workflows
#   git mv .github/deploy-pages.yml.template .github/workflows/deploy.yml
#   git commit -m "ci: deploy no GitHub Pages" && git push
#
# Depois, no GitHub: Settings → Pages → Source: "GitHub Actions".
# (O arquivo vem como .template porque tokens de app não têm permissão
#  para criar workflows automaticamente.)
# ---------------------------------------------------------------------------
